            "data": "\u003cstyle\u003e\n    .data-property-container {\n        height: 55vh;\n        width: 100%;\n        background-color: #f5f5f5;\n        border: 1px solid #ddd;\n        box-sizing: border-box;\n    }\n\n    .data-property-summary {\n        display: list-item;\n        cursor: pointer;\n    }\n\u003c/style\u003e\n\n\u003cdetails open\u003e\n    \u003csummary class\u003d\"data-property-summary\"\u003eData Property\u003c/summary\u003e\n    \u003clabel for\u003d\"20250122-101902_1647981682_search_box\"\u003eSemantic Search:\u003c/label\u003e\n    \u003cinput type\u003d\"text\" id\u003d\"20250122-101902_1647981682_search_box\" placeholder\u003d\"Search...\"/\u003e\n    \u003cbutton id\u003d\"20250122-101902_1647981682_search_button\" type\u003d\"button\" class\u003d\"btn btn-default btn-xs\"\u003eSearch\u003c/button\u003e\n    \u003cdiv id\u003d\"20250122-101902_1647981682_single_container\" class\u003d\"data-property-container panel panel-default\"\u003e\u003c/div\u003e\n    \u003cdetails\u003e\n        \u003csummary class\u003d\"data-property-summary\"\u003eGraph Configuration\u003c/summary\u003e\n        \u003cdiv id\u003d\"20250122-101902_1647981682_configuraion\" style\u003d\"display: block\"\u003e\u003c/div\u003e\n    \u003c/details\u003e\n\u003c/details\u003e\n\n\u003cscript\u003e\n    (async function () {\n        await import(\u0027https://unpkg.com/vis-network/standalone/umd/vis-network.min.js\u0027);\n\n        class IginxExecutor {\n            _noteId;\n\n            constructor() {\n                this._noteId \u003d window.location.hash.split(\u0027/\u0027)[2];\n            }\n\n            async execute(statement) {\n                const notebook \u003d await this._getNotebook();\n                const lastParagraph \u003d notebook.paragraphs.at(-1);\n\n                if (lastParagraph.text) {\n                    alert(\u0027Please create a empty paragraph in last of notebook to execute interpreter\u0027);\n                    throw new Error(\u0027Please create a empty paragraph in last of notebook to execute interpreter\u0027);\n                }\n                const paragraphId \u003d lastParagraph.id;\n\n                await this._updateParagraph(paragraphId, \u0027%iginx \u0027 + statement);\n                const executeResult \u003d await this._executeParagraph(paragraphId);\n\n                await this._updateParagraph(paragraphId, \u0027%iginx \u003edata.property.clear\u0027);\n                await this._executeParagraph(paragraphId);\n\n                await this._updateParagraph(paragraphId, \u0027\u0027);\n                return executeResult;\n            }\n\n            async _getNotebook() {\n                const apiUrl \u003d \u0027api/notebook/\u0027 + this._noteId;\n                const response \u003d await fetch(apiUrl);\n                this._checkResponse(response);\n                return (await response.json()).body;\n            }\n\n            async _updateParagraph(paragraphId, statement) {\n                const apiUrl \u003d \u0027api/notebook/\u0027 + this._noteId + \u0027/paragraph/\u0027 + paragraphId;\n                const response \u003d await fetch(apiUrl, {\n                    method: \u0027PUT\u0027,\n                    headers: {\n                        \u0027Content-Type\u0027: \u0027application/json\u0027,\n                    },\n                    body: JSON.stringify({\n                        text: statement,\n                    })\n                });\n                this._checkResponse(response);\n            }\n\n            async _executeParagraph(paragraphId) {\n                const apiUrl \u003d \u0027api/notebook/run/\u0027 + this._noteId + \u0027/\u0027 + paragraphId;\n                const response \u003d await fetch(apiUrl, {\n                    method: \u0027POST\u0027,\n                });\n                return (await response.json()).body;\n            }\n\n            async _getParagraphResult(paragraphId) {\n                const apiUrl \u003d \u0027api/notebook/\u0027 + this._noteId + \u0027/paragraph/\u0027 + paragraphId;\n                const response \u003d await fetch(apiUrl);\n                return (await response.json()).body;\n            }\n\n            _checkResponse(response) {\n                if (!response.ok) {\n                    const msg \u003d \u0027Status: \u0027 + response.status + \u0027. \u0027 + response.statusText;\n                    alert(msg);\n                    throw new Error(msg);\n                }\n            }\n        }\n\n        const topNodesStr \u003d \u0027[{\"depth\":0,\"id\":\"rootId\",\"name\":\"Data Asset\"},{\"depth\":1,\"id\":\"rootId.strues_boldr\",\"name\":\"strues_boldr\"},{\"depth\":1,\"id\":\"rootId.yellowsunn_security_project\",\"name\":\"yellowsunn_security_project\"},{\"depth\":1,\"id\":\"rootId.Rizq_Solutions_automator_rizq\",\"name\":\"Rizq_Solutions_automator_rizq\"},{\"depth\":1,\"id\":\"rootId.leanhvu21042001_recipes_food\",\"name\":\"leanhvu21042001_recipes_food\"},{\"depth\":1,\"id\":\"rootId.lahdeero_mystash_backend\",\"name\":\"lahdeero_mystash_backend\"},{\"depth\":1,\"id\":\"rootId.philippdormann_umami_sqlite\",\"name\":\"philippdormann_umami_sqlite\"},{\"depth\":1,\"id\":\"rootId.lethanhandeveloper_utcshop_project_web\",\"name\":\"lethanhandeveloper_utcshop_project_web\"},{\"depth\":1,\"id\":\"rootId.banziha104_pinstagram_was\",\"name\":\"banziha104_pinstagram_was\"},{\"depth\":1,\"id\":\"rootId.OngKarWei5107_SEP_PROJECT\",\"name\":\"OngKarWei5107_SEP_PROJECT\"},{\"depth\":1,\"id\":\"rootId.slimooo_railway\",\"name\":\"slimooo_railway\"},{\"depth\":1,\"id\":\"rootId.ititandev_instagram_api_clone\",\"name\":\"ititandev_instagram_api_clone\"},{\"depth\":1,\"id\":\"rootId.novemdecillion_magic_lantern\",\"name\":\"novemdecillion_magic_lantern\"},{\"depth\":1,\"id\":\"rootId.mo_abbas_cmpoj\",\"name\":\"mo_abbas_cmpoj\"},{\"depth\":1,\"id\":\"rootId.priya006_OauthProvider\",\"name\":\"priya006_OauthProvider\"}]\u0027;\n        const topNodes \u003d JSON.parse(topNodesStr);\n\n        const topRelationStr \u003d \u0027[{\"from\":\"rootId.OngKarWei5107_SEP_PROJECT\",\"relation\":\"Two e-commerce projects with overlapping user and transaction entities\",\"score\":0.5356459021568298,\"to\":\"rootId.lethanhandeveloper_utcshop_project_web\"},{\"from\":\"rootId.slimooo_railway\",\"relation\":\"Separate systems managing user accounts\",\"score\":0.5156078338623047,\"to\":\"rootId.lahdeero_mystash_backend\"},{\"from\":\"rootId.lahdeero_mystash_backend\",\"relation\":\"Lahdeero backend manages accounts; Priya006 handles OAuth for access.\",\"score\":0.48969975113868713,\"to\":\"rootId.priya006_OauthProvider\"}]\u0027;\n        const topRelations \u003d JSON.parse(topRelationStr);\n\n        let network;\n        let nodes \u003d [];\n        let edges \u003d [];\n        let data \u003d {\n            nodes: new vis.DataSet(nodes),\n            edges: new vis.DataSet(edges)\n        };\n\n        // 初始化network的数据\n        function initializeGraph() {\n            const rootNode \u003d topNodes[0];\n            data.nodes.add({\n                id: rootNode.id,\n                label: rootNode.name || \"Data Asset\",\n                color: getColorByDepth(rootNode.depth),\n            });\n\n            for (let i \u003d 1; i \u003c topNodes.length; i++) {\n                const childNode \u003d topNodes[i];\n                data.nodes.add({\n                    id: childNode.id,\n                    label: childNode.name,\n                    color: getColorByDepth(childNode.depth),\n                });\n                data.edges.add({\n                    from: rootNode.id,\n                    to: childNode.id,\n                    arrows: \u0027to\u0027\n                });\n            }\n\n            for (let i \u003d 0; i \u003c topRelations.length; i++) {\n                const link \u003d topRelations[i];\n                data.edges.add({\n                    id: link.from + \"-\u003e\" + link.to,\n                    from: link.from,\n                    to: link.to,\n                    arrows: \"\",\n                    color: \"red\",\n                    label: link.relation,\n                })\n            }\n        }\n\n        // 绘制图\n        function drawGraph() {\n            const container \u003d document.getElementById(\u002720250122-101902_1647981682_single_container\u0027);\n            const options \u003d {\n                clickToUse: false,\n                configure: {\n                    container: document.getElementById(\u002720250122-101902_1647981682_configuraion\u0027),\n                },\n                layout: {\n                    improvedLayout: true,\n                    hierarchical: {\n                        enabled: true,\n                        levelSeparation: 350,\n                        nodeSpacing: 32,\n                        direction: \u0027LR\u0027,\n                        sortMethod: \u0027directed\u0027,\n                        shakeTowards: \u0027roots\u0027\n                    }\n                },\n                edges: {\n                    font:{\n                        face: \u0027tahoma\u0027,\n                        align: \u0027top\u0027,\n                    },\n                    smooth: {\n                        type: \"cubicBezier\",\n                        forceDirection: \"horizontal\",\n                    }\n                },\n                nodes:{\n                    opacity: 0.9,\n                    font:{\n                        face: \u0027tahoma\u0027,\n                        align: \u0027left\u0027,\n                    },\n                    shape: \u0027box\u0027,\n                    shadow: true,\n                },\n                interaction:{\n                    hover: true,\n                    multiselect: true,\n                },\n                physics: {\n                    enabled: false,\n                },\n            };\n            network \u003d new vis.Network(container, data, options);\n\n            // 绑定双击事件\n            network.on(\u0027doubleClick\u0027, async function (params) {\n                console.debug(\u0027doubleClick:\u0027, params);\n                if (params.nodes.length \u003e 0) {\n                    const nodeId \u003d params.nodes[0];\n                    console.debug(\u0027nodeId:\u0027, nodeId);\n                    await handleNodeClickWithThrottle(nodeId);\n                }\n            });\n        }\n\n        let lastClickTime \u003d 0;\n        const throttleDelay \u003d 1000;  // 节流间隔\n\n        // 节流函数\n        async function handleNodeClickWithThrottle(nodeId) {\n            const now \u003d Date.now();\n            if (now - lastClickTime \u003e throttleDelay) {\n                lastClickTime \u003d now;\n                await handleNodeClick(nodeId);\n                const runTime \u003d Date.now() - now;\n                console.log(\"handleNodeClick run time for \" + nodeId + \" is: \" + runTime + \"ms\");\n            } else {\n                showFrequentClickAlert();\n            }\n        }\n\n        // 弹出提示框函数\n        function showFrequentClickAlert() {\n            console.log(\"showFrequentClickAlert\");\n            // todo: 设置提示框，提示点击过于频繁\n            setTimeout(() \u003d\u003e {\n                // todo: 去除提示框\n            }, 1000);\n        }\n\n        // 修改节点的颜色根据深度设置\n        function getColorByDepth(depth) {\n            switch (depth) {\n                case 0:\n                    return \u0027#97c2fc\u0027; // 深度为0的颜色\n                case 1:\n                    return \u0027#ffb6c1\u0027; // 深度为1的颜色\n                case 2:\n                    return \u0027#f9a825\u0027; // 深度为2的颜色\n                case 3:\n                    return \u0027#8bc34a\u0027; // 深度为3的颜色\n                case 4:\n                    return \u0027#ff8a65\u0027; // 深度为4的颜色\n                case 5:\n                    return \u0027#90a4ae\u0027; // 深度为5的颜色\n                case 6:\n                    return \u0027#ffeb3b\u0027; // 深度为6的颜色\n                default:\n                    return \u0027#ffffff\u0027; // 默认颜色\n            }\n        }\n\n        // 清除结点间额外关系的边\n        function clearRelation() {\n            const edgesArray \u003d data.edges.get();\n            const edgesToRemove \u003d edgesArray.filter(edge \u003d\u003e {\n                const hasArrow \u003d edge.arrows \u0026\u0026 edge.arrows !\u003d\u003d \"\"; // 是否有箭头\n                const isRedColor \u003d edge.color \u0026\u0026 edge.color \u003d\u003d\u003d \"red\"; // 是否为红色\n                return !hasArrow \u0026\u0026 isRedColor; // 删除无箭头且红色的边\n            });\n            edgesToRemove.forEach(edge \u003d\u003e {\n                data.edges.remove(edge.id);\n            });\n        }\n\n        // 初始化图形\n        initializeGraph();\n        drawGraph();\n\n        async function handleNodeClick(nodeId) {\n            const executor \u003d new IginxExecutor(window.location.protocol, window.location.host);\n            // const notebook \u003d new Notebook(\u0027http:\u0027, \u0027localhost:8080\u0027, \u00272KMMSQPGJ\u0027);\n            console.debug(\u0027handleNodeClick:\u0027, nodeId);\n            const statement \u003d \u0027\u003edata.property.expand 20250122-101902_1647981682 \u0027 + nodeId;\n            const data \u003d await executor.execute(statement);\n            console.debug(\u0027handleNodeClick executeInterpreter result:\u0027, data);\n            const resultJson \u003d JSON.parse(data.msg[0].data);\n            console.debug(\u0027handleNodeClick resultJson:\u0027, resultJson);\n            await handleResult(resultJson);\n        }\n\n        function handleResult(result) {\n            console.log(\"begin handleResult\");\n            // clearRelation();\n            if (result \u0026\u0026 result.add) {\n                console.log(\"handle add\");\n                // 处理 add 中的 nodes\n                if (result.add.nodes) {\n                    result.add.nodes.forEach(node \u003d\u003e {\n                        data.nodes.add({\n                            id: node.id,\n                            label: node.name,\n                            color: getColorByDepth(node.depth),\n                        });\n                    });\n                }\n\n                // 处理 add 中的 edges\n                if (result.add.edges) {\n                    result.add.edges.forEach(edge \u003d\u003e {\n                        data.edges.add({\n                            from: edge.from,\n                            to: edge.to,\n                            arrows: \u0027to\u0027\n                        });\n                    });\n                }\n\n                // 处理 add 中的 links\n                if (result.add.links) {\n                    result.add.links.forEach(link \u003d\u003e {\n                        data.edges.add({\n                            id: link.from + \"-\u003e\" + link.to,\n                            from: link.from,\n                            to: link.to,\n                            arrows: \"\",\n                            color: \"red\",\n                            label: link.relation,\n                        });\n                    });\n                }\n            }\n\n            if (result \u0026\u0026 result.remove) {\n                console.log(\"handle remove\");\n                // 处理 remove 中的 nodes\n                if (result.remove.nodes) {\n                    result.remove.nodes.forEach(node \u003d\u003e {\n                        data.nodes.remove(node.id);\n                        // 删除掉对应的 edges\n                        const edgesToRemove \u003d data.edges.get().filter(edge \u003d\u003e edge.to \u003d\u003d\u003d node.id);\n                        edgesToRemove.forEach(edge \u003d\u003e {\n                            data.edges.remove(edge.id);\n                        });\n                    });\n                }\n            }\n\n            console.log(\"处理完后的data为：\")\n            console.log(data.nodes.get());\n            console.log(data.edges.get());\n        }\n\n        document.getElementById(\u002720250122-101902_1647981682_search_button\u0027).onclick \u003d async () \u003d\u003e {\n            const executor \u003d new IginxExecutor();\n            const result \u003d await executor.execute(\u0027\u003edata.property.search 20250122-101902_1647981682 \u0027 + document.getElementById(\u002720250122-101902_1647981682_search_box\u0027).value);\n            const networkNodeIds \u003d JSON.parse(result.msg[0].data);\n            console.log(\u0027networkNodeIds:\u0027, networkNodeIds);\n            data.nodes.forEach(node \u003d\u003e {\n                data.nodes.update({\n                    id: node.id,\n                    color: {\n                        background: \u0027#ffffff\u0027,\n                        border: \u0027#000000\u0027\n                    }\n                });\n            });\n            networkNodeIds.forEach(nodeId \u003d\u003e {\n                data.nodes.update({\n                    id: nodeId,\n                    color: {\n                        background: \u0027#ffeb3b\u0027,\n                        border: \u0027#fbc02d\u0027\n                    }\n                });\n            });\n        };\n    })();\n\u003c/script\u003e"
          },
