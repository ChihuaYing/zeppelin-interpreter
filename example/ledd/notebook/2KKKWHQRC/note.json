l for\u003d\"20250122-101902_1647981682_search_top_k_box\" style\u003d\"width: 100px; text-align: right;\"\u003e\u003cStrong\u003eTop K: \u003c/Strong\u003e\u003c/label\u003e\n                        \u003cinput type\u003d\"text\" id\u003d\"20250122-101902_1647981682_search_top_k_box\" style\u003d\"width: 100px;\" placeholder\u003d\"10\"/\u003e\n                        \u003cbutton style\u003d\"visibility: hidden; width: 60px;\" type\u003d\"button\" class\u003d\"btn btn-default btn-xs\"\u003e\u003c/button\u003e\n                    \u003c/div\u003e\n                    \u003cdiv style\u003d\"display: flex; align-items: center; gap: 5px; margin-top: 10px;\"\u003e\n                        \u003cdiv style\u003d\"width: 100%; max-width: 600px; max-height: 300px; overflow: auto; border: 1px solid #ddd;\"\u003e\n                            \u003ctable id\u003d\"20250122-101902_1647981682_search_table\" border\u003d\"1\"\n                                   style\u003d\"width: 300px; border-collapse: collapse; margin-top: 10px; table-layout: fixed;\"\u003e\n                                \u003cthead\u003e\n                                \u003ctr\u003e\n                                    \u003cth style\u003d\"width: 50px; text-align: center;\"\u003eNo.\u003c/th\u003e\n                                    \u003cth style\u003d\"width: 250px; text-align: center; white-space: nowrap;\"\u003ePath\u003c/th\u003e\n                                \u003c/tr\u003e\n                                \u003c/thead\u003e\n                                \u003ctbody id\u003d\"20250122-101902_1647981682_search_table_body\"\u003e\n                                \u003ctr\u003e\n                                    \u003ctd style\u003d\"text-align: center;\"\u003e1\u003c/td\u003e\n                                    \u003ctd\u003erootId.*.path.*\u003c/td\u003e\n                                \u003c/tr\u003e\n                                \u003c/tbody\u003e\n                            \u003c/table\u003e\n                        \u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/details\u003e\n\n        \u003c!-- 右侧面板 --\u003e\n        \u003cdiv id\u003d\"20250122-101902_1647981682_rightPanel\" style\u003d\"flex-grow: 1; padding: 10px; transition: width 0.3s;\"\u003e\n            \u003cdiv id\u003d\"20250122-101902_1647981682_single_container\" class\u003d\"data-property-container panel panel-default\"\u003e\u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cdetails\u003e\n        \u003csummary class\u003d\"data-property-summary\"\u003eGraph Configuration\u003c/summary\u003e\n    \u003c/details\u003e\n    \u003cdiv id\u003d\"tooltip\" class\u003d\"data-property-tooltip\"\u003e\u003c/div\u003e\n\u003c/details\u003e\n\n\u003cscript\u003e\n    (async function () {\n        await import(\u0027https://gw.alipayobjects.com/os/antv/pkg/_antv.g6-3.1.1/build/g6.js\u0027);\n        await import(\u0027https://gw.alipayobjects.com/os/antv/assets/lib/jquery-3.2.1.min.js\u0027);\n        await import(\u0027https://gw.alipayobjects.com/os/antv/pkg/_antv.hierarchy-0.5.0/build/hierarchy.js\u0027);\n\n        class IginxExecutor {\n            _noteId;\n\n            constructor() {\n                this._noteId \u003d window.location.hash.split(\u0027/\u0027)[2];\n            }\n\n            async execute(statement) {\n                const notebook \u003d await this._getNotebook();\n                const lastParagraph \u003d notebook.paragraphs.at(-1);\n\n                if (lastParagraph.text) {\n                    alert(\u0027Please create a empty paragraph in last of notebook to execute interpreter\u0027);\n                    throw new Error(\u0027Please create a empty paragraph in last of notebook to execute interpreter\u0027);\n                }\n                const paragraphId \u003d lastParagraph.id;\n\n                await this._updateParagraph(paragraphId, \u0027%iginx \u0027 + statement);\n                const executeResult \u003d await this._executeParagraph(paragraphId);\n\n                await this._updateParagraph(paragraphId, \u0027%iginx \u003edata.property.clear\u0027);\n                await this._executeParagraph(paragraphId);\n\n                await this._updateParagraph(paragraphId, \u0027\u0027);\n                return executeResult;\n            }\n\n            async _getNotebook() {\n                const apiUrl \u003d \u0027api/notebook/\u0027 + this._noteId;\n                const response \u003d await fetch(apiUrl);\n                this._checkResponse(response);\n                return (await response.json()).body;\n            }\n\n            async _updateParagraph(paragraphId, statement) {\n                const apiUrl \u003d \u0027api/notebook/\u0027 + this._noteId + \u0027/paragraph/\u0027 + paragraphId;\n                const response \u003d await fetch(apiUrl, {\n                    method: \u0027PUT\u0027,\n                    headers: {\n                        \u0027Content-Type\u0027: \u0027application/json\u0027,\n                    },\n                    body: JSON.stringify({\n                        text: statement,\n                    })\n                });\n                this._checkResponse(response);\n            }\n\n            async _executeParagraph(paragraphId) {\n                const apiUrl \u003d \u0027api/notebook/run/\u0027 + this._noteId + \u0027/\u0027 + paragraphId;\n                const response \u003d await fetch(apiUrl, {\n                    method: \u0027POST\u0027,\n                });\n                const json \u003d await response.json();\n                console.debug(json);\n                return json.body;\n            }\n\n            async _getParagraphResult(paragraphId) {\n                const apiUrl \u003d \u0027api/notebook/\u0027 + this._noteId + \u0027/paragraph/\u0027 + paragraphId;\n                const response \u003d await fetch(apiUrl);\n                return (await response.json()).body;\n            }\n\n            _checkResponse(response) {\n                if (!response.ok) {\n                    const msg \u003d \u0027Status: \u0027 + response.status + \u0027. \u0027 + response.statusText;\n                    alert(msg);\n                    throw new Error(msg);\n                }\n            }\n        }\n\n        const container \u003d document.getElementById(\u002720250122-101902_1647981682_single_container\u0027);\n        const width \u003d container.clientWidth;\n        const height \u003d container.clientHeight;\n\n        const graph \u003d new G6.TreeGraph({\n            container: container,\n            width: width,\n            height: height,\n            modes: {\n                default: [\u0027drag-canvas\u0027, \u0027zoom-canvas\u0027, \u0027drag-node\u0027],\n            },\n            defaultNode: {\n                type: \u0027rect\u0027,\n                size: [10, 5],\n                style: {\n                    fill: \u0027#97c2fc\u0027,\n                    stroke: \u0027#8f8b8b\u0027,\n                    lineWidth: 1,\n                },\n                labelCfg: {\n                    position: \u0027left\u0027,\n                    offset: 5,\n                    style: {\n                        fill: \u0027#000000\u0027,\n                        fontSize: 12,\n                        textAlign: \u0027right\u0027,\n                    },\n                },\n            },\n            defaultEdge: {\n                shape: \u0027cubic-horizontal\u0027,\n                style: {\n                    stroke: \u0027#A3B1BF\u0027\n                }\n            },\n            layout: {\n                type: \u0027compactBox\u0027,\n                direction: \u0027LR\u0027,\n                getId: function getId(d) {\n                    return d.id;\n                },\n                getHeight: () \u003d\u003e 16,\n                getWidth: () \u003d\u003e 16,\n                getVGap: () \u003d\u003e 10,\n                getHGap: () \u003d\u003e 100\n            }\n        });\n\n        // 初始化数据\n        const topNodesStr \u003d \u0027[{\"depth\":0,\"id\":\"rootId\",\"name\":\"Data Asset\"},{\"depth\":1,\"id\":\"rootId.strues_boldr\",\"name\":\"strues_boldr\"},{\"depth\":1,\"id\":\"rootId.yellowsunn_security_project\",\"name\":\"yellowsunn_security_project\"},{\"depth\":1,\"id\":\"rootId.Rizq_Solutions_automator_rizq\",\"name\":\"Rizq_Solutions_automator_rizq\"},{\"depth\":1,\"id\":\"rootId.leanhvu21042001_recipes_food\",\"name\":\"leanhvu21042001_recipes_food\"},{\"depth\":1,\"id\":\"rootId.lahdeero_mystash_backend\",\"name\":\"lahdeero_mystash_backend\"},{\"depth\":1,\"id\":\"rootId.philippdormann_umami_sqlite\",\"name\":\"philippdormann_umami_sqlite\"},{\"depth\":1,\"id\":\"rootId.lethanhandeveloper_utcshop_project_web\",\"name\":\"lethanhandeveloper_utcshop_project_web\"},{\"depth\":1,\"id\":\"rootId.banziha104_pinstagram_was\",\"name\":\"banziha104_pinstagram_was\"},{\"depth\":1,\"id\":\"rootId.OngKarWei5107_SEP_PROJECT\",\"name\":\"OngKarWei5107_SEP_PROJECT\"},{\"depth\":1,\"id\":\"rootId.slimooo_railway\",\"name\":\"slimooo_railway\"},{\"depth\":1,\"id\":\"rootId.ititandev_instagram_api_clone\",\"name\":\"ititandev_instagram_api_clone\"},{\"depth\":1,\"id\":\"rootId.novemdecillion_magic_lantern\",\"name\":\"novemdecillion_magic_lantern\"},{\"depth\":1,\"id\":\"rootId.mo_abbas_cmpoj\",\"name\":\"mo_abbas_cmpoj\"},{\"depth\":1,\"id\":\"rootId.priya006_OauthProvider\",\"name\":\"priya006_OauthProvider\"}]\u0027;\n        const topNodes \u003d JSON.parse(topNodesStr);\n\n        const topRelationStr \u003d \u0027[]\u0027;\n        const topRelations \u003d JSON.parse(topRelationStr);\n\n        const nodeMap \u003d {};\n\n        // 转换数据为 G6 需要的格式\n        function convertToTreeData(nodes, relations) {\n            const rootNode \u003d nodes[0];\n            const treeData \u003d {\n                id: rootNode.id,\n                label: rootNode.name || \"Data Asset\",\n                depth: rootNode.depth,\n                children: [],\n            };\n\n            nodeMap[rootNode.id] \u003d treeData;\n\n            // 添加子节点\n            for (let i \u003d 1; i \u003c nodes.length; i++) {\n                const node \u003d nodes[i];\n                const parent \u003d nodeMap[node.parentId] || treeData;\n                const child \u003d {\n                    id: node.id,\n                    label: node.name,\n                    depth: node.depth,\n                    children: [],\n                };\n                parent.children.push(child);\n                nodeMap[node.id] \u003d child;\n            }\n\n            // 添加额外关系\n            for (let i \u003d 0; i \u003c relations.length; i++) {\n                const relation \u003d relations[i];\n                const source \u003d nodeMap[relation.from];\n                const target \u003d nodeMap[relation.to];\n                if (source \u0026\u0026 target) {\n                    source.children.push({\n                        id: relation.from + \"-\u003e\" + relation.to,\n                        label: relation.relation,\n                        depth: source.depth + 1,\n                        relation: true,\n                        style: {\n                            stroke: \u0027red\u0027,\n                            lineWidth: 2,\n                        },\n                    });\n                }\n            }\n\n            return treeData;\n        }\n\n        const treeData \u003d convertToTreeData(topNodes, topRelations);\n        console.debug(treeData);\n\n        // 渲染图\n        graph.data(treeData);\n        graph.render();\n        graph.fitView();\n        await resetOverview();\n\n        // 绑定单击事件\n        graph.on(\u0027node:click\u0027, function (evt) {\n            const nodeModel \u003d evt.item.getModel();\n            console.debug(\u0027nodeModel:\u0027, nodeModel.id);\n            handleNodeClickWithThrottle(nodeModel.id);\n        });\n\n        const tooltip \u003d document.getElementById(\u0027tooltip\u0027);\n\n        // 监听鼠标悬浮在结点上\n        graph.on(\u0027node:mouseenter\u0027, (evt) \u003d\u003e {\n            const node \u003d evt.item;\n            const model \u003d node.getModel();\n            graph.updateItem(node, {\n                style: {\n                    stroke: \u0027#d9d6d6\u0027,\n                    lineWidth: 2,\n                },\n            });\n            tooltip.innerText \u003d \"结点: \" + model.id;\n            tooltip.style.display \u003d \u0027block\u0027;\n            tooltip.style.left \u003d \"\" + (evt.clientX) + \"px\";\n            tooltip.style.top \u003d \"\" + (evt.clientY) + \"px\";\n        });\n\n        // 监听鼠标移出结点\n        graph.on(\u0027node:mouseleave\u0027, (evt) \u003d\u003e {\n            const node \u003d evt.item;\n            graph.updateItem(node, {\n                style: {\n                    stroke: \u0027#8f8b8b\u0027,\n                    lineWidth: 1,\n                },\n            });\n            tooltip.style.display \u003d \u0027none\u0027;\n        });\n\n        // 监听鼠标悬浮在边上\n        graph.on(\u0027edge:mouseenter\u0027, (evt) \u003d\u003e {\n            const { item } \u003d evt;\n            const model \u003d item.getModel();\n            if (model.label) {\n                graph.updateItem(item, {\n                    style: {\n                        stroke: \u0027red\u0027,\n                        lineWidth: 2,\n                    },\n                });\n                tooltip.innerText \u003d model.label;\n                tooltip.style.display \u003d \u0027block\u0027;\n                tooltip.style.left \u003d \"\" + (evt.clientX) + \"px\";\n                tooltip.style.top \u003d \"\" + (evt.clientY) + \"px\";\n            }\n        });\n\n        // 监听鼠标离开边\n        graph.on(\u0027edge:mouseleave\u0027, (evt) \u003d\u003e {\n            const { item } \u003d evt;\n            const model \u003d item.getModel();\n            if (model.label) {\n                graph.updateItem(item, {\n                    style: {\n                        stroke: \u0027#ff6666\u0027,\n                        lineWidth: 1,\n                    },\n                });\n                tooltip.style.display \u003d \u0027none\u0027;\n            }\n        });\n\n        let lastClickTime \u003d 0;\n        const throttleDelay \u003d 1000;  // 节流间隔\n\n        // 节流函数\n        async function handleNodeClickWithThrottle(nodeId) {\n            const now \u003d Date.now();\n            if (now - lastClickTime \u003e throttleDelay) {\n                lastClickTime \u003d now;\n                await handleNodeClick(nodeId);\n                const runTime \u003d Date.now() - now;\n                console.log(\"handleNodeClick run time for \" + nodeId + \" is: \" + runTime + \"ms\");\n            } else {\n                showFrequentClickAlert();\n            }\n        }\n\n        // 弹出提示框函数\n        function showFrequentClickAlert() {\n            console.log(\"showFrequentClickAlert\");\n            // todo: 设置提示框，提示点击过于频繁\n            setTimeout(() \u003d\u003e {\n                // todo: 去除提示框\n            }, 1000);\n        }\n\n        // 修改节点的颜色根据深度设置\n        function getColorByDepth(depth) {\n            switch (depth) {\n                case 0:\n                    return \u0027#97c2fc\u0027; // 深度为0的颜色\n                case 1:\n                    return \u0027#ffb6c1\u0027; // 深度为1的颜色\n                case 2:\n                    return \u0027#f9a825\u0027; // 深度为2的颜色\n                case 3:\n                    return \u0027#8bc34a\u0027; // 深度为3的颜色\n                case 4:\n                    return \u0027#ff8a65\u0027; // 深度为4的颜色\n                case 5:\n                    return \u0027#90a4ae\u0027; // 深度为5的颜色\n                case 6:\n                    return \u0027#ffeb3b\u0027; // 深度为6的颜色\n                default:\n                    return \u0027#ffffff\u0027; // 默认颜色\n            }\n        }\n\n        async function handleNodeClick(nodeId) {\n            // todo: 命令中添加上relation UDF的信息\n            const executor \u003d new IginxExecutor(window.location.protocol, window.location.host);\n            console.debug(\u0027handleNodeClick:\u0027, nodeId);\n            const statement \u003d \u0027\u003edata.property.expand 20250122-101902_1647981682 \u0027 + nodeId;\n            const data \u003d await executor.execute(statement);\n            console.debug(\u0027handleNodeClick executeInterpreter result:\u0027, data);\n            const resultJson \u003d JSON.parse(data.msg[0].data);\n            console.debug(\u0027handleNodeClick resultJson:\u0027, resultJson);\n            await handleResult(resultJson, nodeId);\n            await resetOverview();\n        }\n\n        function handleResult(result, nodeId) {\n            console.log(\"begin handleResult\");\n            // clearRelation();\n            if (result \u0026\u0026 result.add) {\n                console.log(\"handle add\");\n                const parent \u003d nodeMap[nodeId];\n                // 处理 add 中的 nodes\n                if (result.add.nodes) {\n                    result.add.nodes.forEach(node \u003d\u003e {\n                        const child \u003d {\n                            id: node.id,\n                            label: node.name,\n                            depth: node.depth,\n                            children: [],\n                        };\n                        parent.children.push(child);\n                        nodeMap[node.id] \u003d child;\n                    });\n                }\n\n                graph.refreshLayout()\n\n                // 处理 add 中的 links\n                if (result.add.links) {\n                    result.add.links.forEach(link \u003d\u003e {\n                        const edgeConfig \u003d {\n                            source: link.from,\n                            target: link.to,\n                            label: link.relation,\n                            style: {\n                                stroke: \u0027#ff6666\u0027,\n                                lineWidth: 1,\n                                radius: 10,\n                            },\n                            labelCfg: {\n                                style: {\n                                    opacity: 0\n                                }\n                            }\n                        };\n                        if (nodeMap[link.from].depth \u003d\u003d\u003d nodeMap[link.to].depth) {\n                            edgeConfig.shape \u003d \u0027quadratic\u0027;\n                            edgeConfig.curveOffset \u003d 150;\n                        }\n                        graph.addItem(\u0027edge\u0027, edgeConfig);\n                    });\n                }\n                graph.fitView();\n            }\n        }\n\n        function resetOverview() {\n            const nodeNum \u003d graph.getNodes().length;\n            const relationNum \u003d graph.getEdges().filter(edge \u003d\u003e edge.getModel().label !\u003d\u003d undefined).length;\n            document.getElementById(\"20250122-101902_1647981682_node_num\").textContent \u003d nodeNum;\n            document.getElementById(\"20250122-101902_1647981682_relation_num\").textContent \u003d relationNum;\n        }\n\n        document.getElementById(\u002720250122-101902_1647981682_search_button\u0027).onclick \u003d async () \u003d\u003e {\n            // todo: 命令中添加上search UDF 和 Top K的信息\n            const executor \u003d new IginxExecutor();\n            const result \u003d await executor.execute(\u0027\u003edata.property.search 20250122-101902_1647981682 \u0027 + document.getElementById(\u002720250122-101902_1647981682_search_box\u0027).value);\n            const networkNodeIds \u003d JSON.parse(result.msg[0].data);\n            console.log(\u0027networkNodeIds:\u0027, networkNodeIds);\n            let tableBody \u003d document.getElementById(\"20250122-101902_1647981682_search_table_body\");\n            tableBody.innerHTML \u003d \"\";\n            networkNodeIds.forEach((nodeId, index) \u003d\u003e {\n                graph.updateItem(nodeId, {\n                    style: {\n                        fill: \u0027#ffeb3b\u0027,\n                        stroke: \u0027#fbc02d\u0027\n                    }\n                });\n                let row \u003d tableBody.insertRow();\n                let cell1 \u003d row.insertCell(0);\n                cell1.style.textAlign \u003d \"center\";\n                cell1.textContent \u003d index + 1;\n                let cell2 \u003d row.insertCell(1);\n                cell2.textContent \u003d nodeId;\n            });\n        };\n\n        document.getElementById(\"20250122-101902_1647981682_sidebar\").addEventListener(\"toggle\", function () {\n            const rightPanel \u003d document.getElementById(\"20250122-101902_1647981682_rightPanel\");\n            const summary \u003d this.querySelector(\"summary\");\n            if (this.open) {\n                rightPanel.style.width \u003d \"calc(100% - 320px)\";\n                summary.textContent \u003d \"☰ Hide Sidebar\";\n            } else {\n                rightPanel.style.width \u003d \"100%\";\n                summary.textContent \u003d \"☰ Show Sidebar\";\n            }\n        });\n    })();\n\u003c/script\u003e\n"
