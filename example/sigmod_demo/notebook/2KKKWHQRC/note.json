            "data": "\u003chtml lang\u003d\"en\"\u003e\n    \u003chead\u003e\n        \u003cmeta charset\u003d\"UTF-8\"\u003e\n        \u003ctitle\u003e\u003c/title\u003e\n        \u003cstyle\u003e\n\n            .highcharts-figure {\n                margin: 0 auto;\n                max-width: 100vw;\n                min-width: 60vw;\n            }\n            #20250115-125355_1750796147_single_container {\n                height: 35rem;\n            }\n            .large-tree{\n                width: 100vw;\n                margin: 0 calc((100vw - 100vw) / 2);\n            }\n            .middle-tree{\n                width: 80vw;\n                margin: 0 calc((100vw - 80vw) / 2);\n            }\n            .small-tree{\n                width: 55vw;\n                margin: 0 calc((100vw - 60vw) / 2);\n            }\n            .toggle-button {\n                padding: 0 5px;\n                border: none;\n                background-color: transparent;\n                color: inherit;\n                cursor: pointer;\n                font-size: 14px;\n            }\n            .toggle-button::before {\n                content: \"\u003e\u003e \";\n                color: #333;\n            }\n            .toggle-button:hover {\n                color: #2e70a8;\n            }\n            .toggle-button:hover::before {\n                color: #2e70a8;\n            }\n        \u003c/style\u003e\n    \u003c/head\u003e\n    \u003cbody\u003e\n        \u003cbutton id\u003d\"20250115-125355_1750796147_toggleButton\" class\u003d\"toggle-button\"\u003e显示数据资产\u003c/button\u003e\n        \u003cfigure class\u003d\"highcharts-figure\"\u003e\n            \u003cdiv id\u003d\"20250115-125355_1750796147_single_container\" style\u003d\"display: none\"\u003e\u003c/div\u003e\n        \u003c/figure\u003e\n        \u003cscript\u003e\n            function loadLibrary(src) {\n                return new Promise((resolve, reject) \u003d\u003e {\n                    const script \u003d document.createElement(\u0027script\u0027);\n                    script.src \u003d src;\n                    script.onload \u003d resolve;\n                    script.onerror \u003d reject;\n                    document.head.appendChild(script);\n                });\n            }\n            var cc ;\n            async function init() {\n                try {\n                    // await loadLibrary(\u0027lib/highcharts.js\u0027);\n                    // await loadLibrary(\u0027lib/treemap.js\u0027);\n                    // await loadLibrary(\u0027lib/treegraph.js\u0027);\n                    // await loadLibrary(\u0027lib/exporting.js\u0027);\n                    // await loadLibrary(\u0027lib/accessibility.js\u0027);\n                    await loadLibrary(\u0027https://code.highcharts.com/highcharts.js\u0027);\n                    await loadLibrary(\u0027https://code.highcharts.com/modules/treemap.js\u0027);\n                    await loadLibrary(\u0027https://code.highcharts.com/modules/treegraph.js\u0027);\n                    // await loadLibrary(\u0027https://code.highcharts.com/modules/exporting.js\u0027);\n                    await loadLibrary(\u0027https://code.highcharts.com/modules/accessibility.js\u0027);\n                    console.log(\u0027MyLibrary 已加载\u0027);\n                    // 继续执行依赖于库的代码\n                    let nodeList \u003d [{\"depth\":0,\"id\":\"rootId\",\"name\":\"\",\"parent\":\"undefined\"},{\"depth\":1,\"id\":\"rootId.demo\",\"name\":\"demo\",\"parent\":\"rootId\"},{\"depth\":2,\"id\":\"rootId.demo.test\",\"name\":\"test\",\"parent\":\"rootId.demo\"},{\"depth\":2,\"id\":\"rootId.demo.todo\",\"name\":\"todo\",\"parent\":\"rootId.demo\"}];\n                    let depth \u003d 3;\n                    let element \u003d document.getElementById(\u002720250115-125355_1750796147_single_container\u0027);\n                    if(depth\u003c5){\n                        element.classList.toggle(\"small-tree\");\n                    }else if(depth\u003c10){\n                        element.classList.toggle(\"middle-tree\");\n                    }else{\n                        element.classList.toggle(\"large-tree\");\n                    }\n                    cc \u003d Highcharts.chart(\"20250115-125355_1750796147_single_container\", {\n                        chart: {\n                            spacingBottom: 30,\n                            marginRight: 200,\n                            style: {\n                                fontFamily: \"Helvetica, Arial, sans-serif\",\n                                fontSize: \u00272rem\u0027\n                            }\n                        },\n                        credits: {\n                            enabled: false\n                        },\n                        title: {\n                            text: \"数据资产\"\n                        },\n                        series: [\n                            {\n                                type: \"treegraph\",\n                                keys: [\"parent\", \"id\", \"name\",\"level\"],\n                                clip: false,\n                                data: nodeList,\n                                marker: {\n                                    symbol: \"circle\",\n                                    radius: 6,\n                                    fillColor: \"#ffffff\",\n                                    lineWidth: 3\n                                },\n                                dataLabels: {\n                                    align: \"left\",\n                                    pointFormat: \"{point.name}\",\n                                    style: {\n                                        color: \"#000000\",\n                                        textOutline: \"3px #ffffff\",\n                                        whiteSpace: \"nowrap\"\n                                    },\n                                    x: 24,\n                                    crop: false,\n                                    overflow: \"none\"\n                                },\n                                levels: [\n                                    {\n                                        level: 1,\n                                        levelIsConstant: false,\n                                        collapsed: false\n                                    },\n                                    {\n                                        level: 2,\n                                        colorByPoint: true,\n                                        collapsed: true\n                                    },\n                                    {\n                                        level: 3,\n                                        colorVariation: {\n                                            key: \"brightness\",\n                                            to: -0.5\n                                        },\n                                        collapsed: true\n                                    },\n                                    {\n                                        level: 4,\n                                        colorVariation: {\n                                            key: \"brightness\",\n                                            to: 0.5\n                                        },\n                                        collapsed: true\n                                    },\n                                    {\n                                        level: 6,\n                                        dataLabels: {\n                                            x: 10\n                                        },\n                                        marker: {\n                                            radius: 4\n                                        },\n                                        collapsed: true\n                                    }\n                                ],\n                            }\n                        ],\n                        plotOptions: {\n                            series: {\n                                point: {\n                                    events: {\n\n                                        click: function () {\n                                            const node \u003d this;  // 获取当前点击的节点\n                                            // 监听节点的展开/折叠状态\n                                            if (node.collapsed) {\n                                                console.log(\u0027Node Expanded:\u0027, node.name);\n                                                node.setState(\u0027normal\u0027);  // 展开节点\n                                            } else {\n                                                console.log(\u0027Node Collapsed:\u0027, node.name);\n                                                node.setState(\u0027inactive\u0027);  // 折叠节点\n                                            }\n                                            // 计算并输出展开节点最多的层及其层高\n                                            calculateMaxExpandedLayerHeight();\n                                        }\n\n                                    }\n                                }\n                            }\n                        }\n                    });\n                } catch (error) {\n                    console.error(\u0027加载失败:\u0027, error);\n                }\n                afterLoad();\n            }\n            init();\n            // 计算展开节点最多的层和层高\n            function calculateMaxExpandedLayerHeight() {\n                const levelCount \u003d {};  // 用来记录每个层级的展开节点数\n                const nodeLevel \u003d {};   // 用来记录每个节点的层级\n                data \u003d cc.series[0].points;\n                // 遍历所有节点，记录每个节点的层级\n                function traverse(node, level) {\n                    nodeLevel[node.id] \u003d level;\n\n                    // 如果节点展开，则计数该层级\n                    if (!levelCount[level]) {\n                        levelCount[level] \u003d 0;\n                    }\n                    levelCount[level]++;\n\n                    // 遍历所有子节点\n                    if (typeof node.collapsed !\u003d\u003d \"undefined\" \u0026\u0026 !node.collapsed) {\n                        const children \u003d data.filter(child \u003d\u003e child.parent \u003d\u003d\u003d node.id);\n                        children.forEach(child \u003d\u003e traverse(child, level + 1));\n                    }\n\n                }\n\n                // 遍历根节点\n                const rootNode \u003d data.find(node \u003d\u003e node.parent \u003d\u003d\u003d \"undefined\");\n                traverse(rootNode, 0);\n\n                // 找到展开节点最多的层和层高\n                let maxLevel \u003d -1;\n                let maxNodes \u003d 0;\n                for (let level in levelCount) {\n                    if (levelCount[level] \u003e maxNodes) {\n                        maxNodes \u003d levelCount[level];\n                        maxLevel \u003d level;\n                    }\n                }\n                console.log(\u0027层高最多的层是：\u0027, maxLevel);\n                console.log(\u0027最多展开的节点数：\u0027, maxNodes);\n                var totalHeight \u003d 35;\n                var container \u003d document.getElementById(\u002720250115-125355_1750796147_single_container\u0027);\n                // 重新绘制图表以适应新的高度\n                container.style.height \u003d (totalHeight + maxNodes) + \u0027rem\u0027;\n                // 使用 chart.update 方法更新图表配置，保持动画效果\n                cc.update({\n                    chart: {\n                        height: container.offsetHeight // 或者你计算出的新高度\n                    }\n                }, true);\n            }\n\n            // 在图表渲染完后，隐藏根节点\n            function afterLoad() {\n                // setTimeout(() \u003d\u003e {\n                if(true){\n                    return;\n                }\n                console.log(\"隐藏根节点\");\n                const nodes \u003d cc.series[0].points;\n                const links \u003d cc.series[0].links;\n\n                // 找到根节点并设置其不可见\n                const rootNode1 \u003d nodes.find(node \u003d\u003e node.id \u003d\u003d\u003d \u0027rootId\u0027); // 根节点的 id 是 \u00270\u0027\n\n                if (rootNode1) {\n                    const nodeElement \u003d rootNode1.graphic.element;\n                    if (nodeElement) {\n                        nodeElement.style.opacity \u003d 0;  // 隐藏根节点\n                    }\n                    // 隐藏根节点的标签（文字）\n                    const labelElement \u003d rootNode1.dataLabel ? rootNode1.dataLabel.element : null;\n                    if (labelElement) {\n                        labelElement.style.opacity \u003d 0;  // 隐藏标签\n                    }\n                }\n\n                // 遍历所有边，隐藏与根节点相关的边\n                links.forEach(link \u003d\u003e {\n                    if (link.fromNode.id \u003d\u003d\u003d \u0027rootId\u0027 || link.toNode.id \u003d\u003d\u003d \u0027rootId\u0027) {  // 连接根节点的边\n                        // 将根节点的边设置为透明\n                        const linkElement \u003d link.graphic.element;\n                        if (linkElement) {\n                            linkElement.style.stroke \u003d \u0027transparent\u0027;  // 隐藏边\n                            linkElement.style.opacity \u003d 0;  // 确保边不可见\n                        }\n                    }\n                });\n                // }, 500);  // 延迟调用，确保图表已经渲染完成\n            }\n\n            document.getElementById(\u002720250115-125355_1750796147_toggleButton\u0027).addEventListener(\u0027click\u0027, function() {\n                var container \u003d document.getElementById(\u002720250115-125355_1750796147_single_container\u0027);\n                if (container.style.display \u003d\u003d\u003d \u0027none\u0027 || container.classList.contains(\u0027hidden\u0027)) {\n                    // 显示图表\n                    container.style.display \u003d \u0027block\u0027;\n                    cc.redraw(); // 重新绘制图表，确保它正确显示\n                    this.innerText\u003d\"隐藏数据资产\"\n                } else {\n                    // 隐藏图表\n                    container.style.display \u003d \u0027none\u0027;\n                    this.innerText\u003d\"显示数据资产\"\n                }\n            });\n        \u003c/script\u003e\n    \u003c/body\u003e\n\u003c/html\u003e\n"
          },
