            "data": "\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\"en\"\u003e\n\u003chead\u003e\n    \u003cmeta charset\u003d\"UTF-8\"\u003e\n    \u003ctitle\u003eTitle\u003c/title\u003e\n  \u003cstyle\u003e\n    .tableDiv {\n      display: none;\n    }\n\n  \u003c/style\u003e\n  \n\u003c/head\u003e\n\u003cbody\u003e\n\u003cdiv class\u003d\"tableDiv\"\u003e\n\u003c/div\u003e\n\u003cscript\u003e\n        setTimeout(function(){\n                var paragraphDiv \u003d document.querySelector(\u0027[id\u003d\\\"20250125-134855_148875984_container\\\"]\u0027);\n                var allChildren \u003d paragraphDiv.querySelectorAll(\"*\");\n                if(\u0027TEXT\u0027\u003d\u003d\u003d\u0027TABLE\u0027){\n                        document.querySelector(\u0027[id\u003d\\\"20250125-134855_148875984_container\\\"]\u0027).style.fontSize\u003d\u00279.0\u0027+\u0027pt\u0027;\n                } else{\n                        Array.from(allChildren).forEach(function (child) {\n                                if(matchesIdPattern(child.id,\u0027text\u0027)){\n                                        document.getElementById(child.id).style.setProperty(\u0027font-size\u0027, \u00279.0\u0027+\u0027pt\u0027, \u0027important\u0027);\n                                }\n                        });\n                }\n                // 命令区域字体\n                document.querySelector(\u0027[id\u003d\\\"20250125-134855_148875984_editor\\\"]\u0027).style.fontSize\u003d\u00279.0\u0027+\u0027pt\u0027;\n                document.querySelector(\u0027[id\u003d\\\"20250125-134855_148875984_editor\\\"]\u0027).style.height\u003d(9.0*1.33 + 5)+\u0027px\u0027;\n                // 非table图表字体\n                Array.from(allChildren).forEach(function (child) {\n                        if(matchesIdPattern(child.id,\u0027switch\u0027)){\n                                var viewBtns \u003d  document.getElementById(child.id).querySelectorAll(\"button\");\n                                Array.from(view