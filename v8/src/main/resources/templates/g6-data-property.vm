<style>
    .data-property-container {
        height: 80vh;
        width: 100%;
        background-color: #f5f5f5;
        border: 1px solid #ddd;
        box-sizing: border-box;
    }

    .data-property-summary {
        display: list-item;
        cursor: pointer;
    }

    .data-property-tooltip {
        position: absolute;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
        display: none;
        pointer-events: none;
        font-size: 12px;
    }
</style>

<details open>
    <summary class="data-property-summary">Data Property</summary>
    <div style="display: flex; padding: 10px; gap: 10px;">
        <!-- 左侧面板 -->
        <details open id="${paragraphId}_sidebar" style="display: flex; flex-direction: row-reverse; transition: width 0.3s;">
            <summary style="writing-mode: vertical-rl; text-align: center; padding: 10px; background: #6c757d; color: white; cursor: pointer; border-left: 1px solid #ccc;">
                ☰ Hide Sidebar
            </summary>
            <div id="${paragraphId}_leftPanel" style="width: 300px; padding: 10px; border-right: 1px solid #ccc; background: #f8f9fa;">
                <div style="border: 1px solid #ddd; padding: 10px; border-radius: 5px;">
                    <h4><span style="color: #808080;">Title</span></h4>
                    <div style="margin-bottom: 12px;"><span>description</span></div>
                    <div style="background-color: #6c757d; color: white; padding: 5px 10px; border-radius: 5px; font-size: 1.2rem; display: inline-block;">
                        Overview
                    </div>
                    <div style="display: flex; gap: 20px;">
                        <div style="margin-top: 10px;"><strong>Nodes: </strong><span id="${paragraphId}_node_num"></span></div>
                        <div style="margin-top: 10px;"><strong>Relations: </strong><span id="${paragraphId}_relation_num"></span></div>
                    </div>
                    <hr>
                    <div style="background-color: #6c757d; color: white; padding: 5px 10px; border-radius: 5px; font-size: 1.2rem; display: inline-block;">
                        Choose
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 10px;">
                        <div style="display: flex; align-items: center;">
                            <label for="${paragraphId}_relation_select" style="margin-right: 10px; width: 100px; text-align: right;"><strong>Relation UDF：</strong></label>
                            <select id="${paragraphId}_relation_select" style="padding: 5px; border: 1px solid #ccc; border-radius: 4px;">
                                <option value="analyse_relation">analyse_relation</option>
                            </select>
                        </div>
                        <div style="display: flex; align-items: center;">
                            <label for="${paragraphId}_search_select" style="margin-right: 10px; width: 100px; text-align: right;"><strong>Search UDF：</strong></label>
                            <select id="${paragraphId}_search_select" style="padding: 5px; border: 1px solid #ccc; border-radius: 4px;">
                                <option value="search_embedding">search_embedding</option>
                            </select>
                        </div>
                    </div>
                    <hr>
                    <div style="background-color: #6c757d; color: white; padding: 5px 10px; border-radius: 5px; font-size: 1.2rem; display: inline-block;">
                        Semantic Search
                    </div>
                    <div style="display: flex; align-items: center; gap: 5px; margin-top: 10px;">
                        <label for="${paragraphId}_search_box" style="width: 100px; text-align: right;"><Strong>Keyword: </Strong></label>
                        <input type="text" id="${paragraphId}_search_box" style="width: 100px;" placeholder="Search..."/>
                        <button id="${paragraphId}_search_button" style="width: 60px;" type="button" class="btn btn-default btn-xs">Search</button>
                    </div>
                    <div style="display: flex; align-items: center; gap: 5px; margin-top: 10px;">
                        <label for="${paragraphId}_search_top_k_box" style="width: 100px; text-align: right;"><Strong>Top K: </Strong></label>
                        <input type="text" id="${paragraphId}_search_top_k_box" style="width: 100px;" value="10"/>
                        <button style="visibility: hidden; width: 60px;" type="button" class="btn btn-default btn-xs"></button>
                    </div>
                    <div style="display: flex; align-items: center; gap: 5px; margin-top: 10px;">
                        <div style="width: 100%; max-width: 600px; max-height: 300px; overflow: auto; border: 1px solid #ddd;">
                            <table id="${paragraphId}_search_table" border="1"
                                   style="width: 300px; border-collapse: collapse; margin-top: 10px; table-layout: fixed;">
                                <thead>
                                <tr>
                                    <th style="width: 50px; text-align: center;">No.</th>
                                    <th style="width: 200px; text-align: center; white-space: nowrap;">Path</th>
                                    <th style="width: 50px; text-align: center;">similarity</th>
                                </tr>
                                </thead>
                                <tbody id="${paragraphId}_search_table_body">
                                <tr>
                                    <td style="text-align: center;">1</td>
                                    <td>*.path.*</td>
                                    <td>0.88</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </details>

        <!-- 右侧面板 -->
        <div id="${paragraphId}_rightPanel" style="flex-grow: 1; padding: 10px; transition: width 0.3s;">
            <div id="${paragraphId}_single_container" class="data-property-container panel panel-default"></div>
            <div style="margin-top: 15px; padding: 10px; border: 1px solid #ddd; background-color: #f8f9fa; border-radius: 5px;">
                <strong>Notice：</strong>
                <span style="color: #c86464;">&#9679;</span> : cluster node,
                <span style="color: #d0aa4a;">&#9679;</span> : searched node,
                <span style="display: inline-block; width: 6px; height: 6px; border: 2px solid goldenrod; border-radius: 50%;"></span> : parent node of searched node
            </div>
        </div>
    </div>

    <details>
        <summary class="data-property-summary">Graph Configuration</summary>
    </details>
    <div id="tooltip" class="data-property-tooltip"></div>
</details>

<script>
    (async function () {
        await import('https://gw.alipayobjects.com/os/antv/pkg/_antv.g6-3.1.1/build/g6.js');
        await import('https://gw.alipayobjects.com/os/antv/assets/lib/jquery-3.2.1.min.js');
        await import('https://gw.alipayobjects.com/os/antv/pkg/_antv.hierarchy-0.5.0/build/hierarchy.js');

        class IginxExecutor {
            _noteId;

            constructor() {
                this._noteId = window.location.hash.split('/')[2];
            }

            async execute(statement) {
                const notebook = await this._getNotebook();
                const lastParagraph = notebook.paragraphs.at(-1);

                if (lastParagraph.text) {
                    handleError('Please create a empty paragraph in last of notebook to execute interpreter');
                }
                const paragraphId = lastParagraph.id;

                await this._updateParagraph(paragraphId, '%iginx ' + statement);
                const executeResult = await this._executeParagraph(paragraphId);

                await this._updateParagraph(paragraphId, '%iginx >data.property.clear');
                await this._executeParagraph(paragraphId);

                await this._updateParagraph(paragraphId, '');
                return executeResult;
            }

            async _getNotebook() {
                const apiUrl = 'api/notebook/' + this._noteId;
                const response = await fetch(apiUrl);
                this._checkResponse(response);
                return (await response.json()).body;
            }

            async _updateParagraph(paragraphId, statement) {
                const apiUrl = 'api/notebook/' + this._noteId + '/paragraph/' + paragraphId;
                const response = await fetch(apiUrl, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        text: statement,
                    })
                });
                this._checkResponse(response);
            }

            async _executeParagraph(paragraphId) {
                const apiUrl = 'api/notebook/run/' + this._noteId + '/' + paragraphId;
                const response = await fetch(apiUrl, {
                    method: 'POST',
                });
                const json = await response.json();
                console.debug(json);
                return json.body;
            }

            async _getParagraphResult(paragraphId) {
                const apiUrl = 'api/notebook/' + this._noteId + '/paragraph/' + paragraphId;
                const response = await fetch(apiUrl);
                return (await response.json()).body;
            }

            _checkResponse(response) {
                if (!response.ok) {
                    const msg = 'Status: ' + response.status + '. ' + response.statusText;
                    handleError(msg);
                }
            }
        }

        const container = document.getElementById('${paragraphId}_single_container');
        const width = container.clientWidth;
        const height = container.clientHeight;

        const graph = new G6.TreeGraph({
            container: container,
            width: width,
            height: height,
            modes: {
                default: ['drag-canvas', 'zoom-canvas', 'drag-node'],
            },
            defaultNode: {
                type: 'rect',
                size: [10, 5],
                style: {
                    fill: '#97c2fc',
                    stroke: '#8f8b8b',
                    lineWidth: 1,
                },
                labelCfg: {
                    position: 'left',
                    offset: 5,
                    style: {
                        fill: '#000000',
                        fontSize: 12,
                        textAlign: 'right',
                    },
                },
            },
            defaultEdge: {
                shape: 'cubic-horizontal',
                style: {
                    stroke: '#A3B1BF'
                }
            },
            layout: {
                type: 'compactBox',
                direction: 'LR',
                getId: function getId(d) {
                    return d.id;
                },
                getHeight: () => 16,
                getWidth: () => 16,
                getVGap: () => 10,
                getHGap: () => 100
            }
        });

        // 初始化数据
        const topNodesStr = '${nodeList}';
        const topNodes = JSON.parse(topNodesStr);

        const topRelationStr = '${relationList}';
        const topRelations = JSON.parse(topRelationStr);

        const nodeMap = {};
        let searchedNodes = [];

        // 转换数据为 G6 需要的格式
        function convertToTreeData(nodes, relations) {
            const rootNode = nodes[0];
            const treeData = {
                id: rootNode.id,
                label: rootNode.name || "Data Asset",
                depth: rootNode.depth,
                children: [],
            };

            nodeMap[rootNode.id] = treeData;

            // 添加子节点
            for (let i = 1; i < nodes.length; i++) {
                const node = nodes[i];
                const parent = nodeMap[node.parentId] || treeData;
                const child = {
                    id: node.id,
                    label: node.name,
                    depth: node.depth,
                    children: [],
                    style: node.merge === true ? { fill: '#c86464', stroke: '#8f8b8b'} : {fill: '#97c2fc', stroke: '#8f8b8b'},
                };
                parent.children.push(child);
                nodeMap[node.id] = child;
            }

            // 添加额外关系
            handleRelation(relations);

            return treeData;
        }

        const treeData = convertToTreeData(topNodes, topRelations);
        console.debug(treeData);

        // 渲染图
        graph.data(treeData);
        graph.render();
        graph.fitView();
        await resetOverview();

        // 绑定单击事件
        graph.on('node:click', function (evt) {
            const nodeModel = evt.item.getModel();
            console.debug('nodeModel:', nodeModel.id);
            handleNodeClickWithThrottle(nodeModel.id);
        });

        const tooltip = document.getElementById('tooltip');
        const nodeStyle = {};

        // 监听鼠标悬浮在结点上
        graph.on('node:mouseenter', (evt) => {
            const node = evt.item;
            const model = node.getModel();
            nodeStyle.style = { ...model.style }
            graph.updateItem(node, {
                style: {
                    stroke: '#d9d6d6',
                    lineWidth: 2,
                },
            });
            tooltip.innerText = "Node: " + model.id.replace("rootId.", "");
            tooltip.style.display = 'block';
            tooltip.style.left = "" + (evt.clientX) + "px";
            tooltip.style.top = "" + (evt.clientY) + "px";
        });

        // 监听鼠标移出结点
        graph.on('node:mouseleave', (evt) => {
            const node = evt.item;
            if (nodeStyle.style) {
                graph.updateItem(node, { style: nodeStyle.style });
            }
            tooltip.style.display = 'none';
        });

        // 监听鼠标悬浮在边上
        graph.on('edge:mouseenter', (evt) => {
            const { item } = evt;
            const model = item.getModel();
            if (model.label) {
                graph.updateItem(item, {
                    style: {
                        stroke: 'red',
                        lineWidth: 2,
                    },
                });
                tooltip.innerText = model.label + "\nsimilarity is: " + model.score;
                tooltip.style.display = 'block';
                tooltip.style.left = "" + (evt.clientX) + "px";
                tooltip.style.top = "" + (evt.clientY) + "px";
            }
        });

        // 监听鼠标离开边
        graph.on('edge:mouseleave', (evt) => {
            const { item } = evt;
            const model = item.getModel();
            if (model.label) {
                graph.updateItem(item, {
                    style: {
                        stroke: '#ff6666',
                        lineWidth: 1,
                    },
                });
                tooltip.style.display = 'none';
            }
        });

        let lastClickTime = 0;
        const throttleDelay = 1000;  // 节流间隔

        // 节流函数
        async function handleNodeClickWithThrottle(nodeId) {
            const now = Date.now();
            if (now - lastClickTime > throttleDelay) {
                lastClickTime = now;
                await handleNodeClick(nodeId);
                const runTime = Date.now() - now;
                console.log("handleNodeClick run time for " + nodeId + " is: " + runTime + "ms");
            } else {
                showFrequentClickAlert();
            }
        }

        // 弹出提示框函数
        function showFrequentClickAlert() {
            handleError("Your requests are too frequent");
            setTimeout(() => {
            }, 1000);
        }

        async function handleNodeClick(nodeId) {
            const executor = new IginxExecutor(window.location.protocol, window.location.host);
            console.debug('handleNodeClick:', nodeId);
            const selectedUDF = document.getElementById("${paragraphId}_relation_select").value;
            const statement = '>data.property.expand ${paragraphId} ' + nodeId + ' UDF' + selectedUDF;
            const data = await executor.execute(statement);
            console.debug('handleNodeClick executeInterpreter result:', data);
            const resultJson = JSON.parse(data.msg[0].data);
            console.debug('handleNodeClick resultJson:', resultJson);
            await handleResult(resultJson, nodeId);
            await resetOverview();
            if (resultJson.add.nodes) {
                await refreshSearch(resultJson.add.nodes.map(node => node.id));
            }
        }

        function handleResult(result, nodeId) {
            console.log("begin handleResult");
            // clearRelation();
            if (result && result.add) {
                const parent = nodeMap[nodeId];
                // 处理 add 中的 nodes
                if (result.add.nodes) {
                    result.add.nodes.forEach(node => {
                        const child = {
                            id: node.id,
                            label: node.name,
                            depth: node.depth,
                            children: [],
                            style: node.merge ? { fill: '#c86464', stroke: '#8f8b8b'} : {fill: '#97c2fc', stroke: '#8f8b8b'},
                        };
                        parent.children.push(child);
                        nodeMap[node.id] = child;
                    });
                }

                graph.refreshLayout()

                // 处理 add 中的 links
                if (result.add.links) {
                    handleRelation(result.add.links);
                }
                graph.fitView();
            }
        }

        function handleRelation(links) {
            links.forEach((link, index) => {
                const edgeConfig = {
                    source: link.from,
                    target: link.to,
                    label: link.relation,
                    score: link.score,
                    style: {
                        stroke: '#ff6666',
                        lineWidth: 1,
                        radius: 10,
                    },
                    labelCfg: {
                        style: {
                            opacity: 0
                        }
                    }
                };
                if (nodeMap[link.from].depth === nodeMap[link.to].depth) {
                    edgeConfig.shape = 'quadratic';

                    const sourceNode = graph.findById(link.from).getModel();
                    const targetNode = graph.findById(link.to).getModel();
                    const dx = targetNode.x - sourceNode.x;
                    const dy = targetNode.y - sourceNode.y;
                    const distance = Math.sqrt(dx * dx + dy * dy);
                    edgeConfig.curveOffset = Math.max(50, Math.min(distance * 0.3, 300)) *  (index % 2 === 0 ? 1 : -1);
                    console.debug(link.from + " - " + link.to + " - edgeConfig.curveOffset is: " + edgeConfig.curveOffset);
                    // edgeConfig.curveOffset = 150;
                }
                graph.addItem('edge', edgeConfig);
            });
        }


        function resetOverview() {
            const nodeNum = graph.getNodes().length;
            const relationNum = graph.getEdges().filter(edge => edge.getModel().label !== undefined).length;
            document.getElementById("${paragraphId}_node_num").textContent = nodeNum;
            document.getElementById("${paragraphId}_relation_num").textContent = relationNum;
        }

        function handleError(error) {
            alert(error);
            throw new Error(error);
        }

        document.getElementById('${paragraphId}_search_button').onclick = async () => {
            const executor = new IginxExecutor();
            const keyword = document.getElementById('${paragraphId}_search_box').value.trim();
            if (keyword === "") {
                handleError('Please enter a non-empty keyword');
            }
            const topK = Number(document.getElementById("${paragraphId}_search_top_k_box").value.trim());
            if (!Number.isInteger(topK) || topK <= 0) {
                handleError('Please enter an integer greater than 0');
            }
            const selectedUDF = document.getElementById("${paragraphId}_search_select").value;
            const statement = '>data.property.search ${paragraphId} ' + topK + ' UDF' + selectedUDF + ' ' + keyword;
            const result = await executor.execute(statement);
            searchedNodes = JSON.parse(result.msg[0].data);
            console.log('searchedNodes: ' + searchedNodes);
            await handleResearch();
            await refreshSearch(Object.keys(nodeMap));
        };

        function handleResearch() {
            let tableBody = document.getElementById("${paragraphId}_search_table_body");
            tableBody.innerHTML = "";
            searchedNodes.forEach((node, index) => {
                let row = tableBody.insertRow();
                let cell1 = row.insertCell(0);
                cell1.style.textAlign = "center";
                cell1.textContent = index + 1;
                let parts = node.id.split(".");
                for (let i = 0; i < Math.min(node.mergeLevel, parts.length); i++) {
                    parts[i] = `<span style="color: red;">` + parts[i]  + `</span>`;
                }
                parts.shift();
                let formattedId = parts.join(".");
                let cell2 = row.insertCell(1);
                cell2.innerHTML = formattedId;
                let cell3 = row.insertCell(2);
                cell3.textContent = node.score;
            });
        }

        // 填充变色：表示该结点是searchedNode；边框变色：表示该结点是某searchedNode的父结点
        function refreshSearch(ids) {
            for (let i = 0; i < ids.length; i++) {
                for (let j = 0; j < searchedNodes.length; j++) {
                    if (ids[i] === searchedNodes[j].id) {
                        graph.updateItem(ids[i], {
                            style: {
                                fill: '#d0aa4a'
                            }
                        });
                    } else if (searchedNodes[j].id.startsWith(ids[i])) {
                        graph.updateItem(ids[i], {
                            style: {
                                stroke: '#ffe500'
                            }
                        });
                    }
                }
            }
        }

        document.getElementById("${paragraphId}_sidebar").addEventListener("toggle", function () {
            const rightPanel = document.getElementById("${paragraphId}_rightPanel");
            const summary = this.querySelector("summary");
            if (this.open) {
                rightPanel.style.width = "calc(100% - 320px)";
                summary.textContent = "☰ Hide Sidebar";
            } else {
                rightPanel.style.width = "100%";
                summary.textContent = "☰ Show Sidebar";
            }
        });
    })();
</script>
